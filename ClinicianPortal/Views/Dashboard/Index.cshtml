@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // Automatically show modal when page loads
        document.addEventListener('DOMContentLoaded', function () {
            var myModal = new bootstrap.Modal(document.getElementById('smallModal'));
            myModal.show();
        });
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clinician Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">

    <style>
        .custom-box {
    width: 280px;
    border-radius: 12px;
    box-shadow: 0px 2px 10px rgba(0,0,0,0.15);
}
        body {
            font-family: 'Lato', sans-serif;
            background-color: #f8f9fa;
        }

        footer {
            margin-top: 60px;
            text-align: center;
            color: #6c757d;
        }

        .custom-modal {
            max-width: 90%; /* increase width */
            height: 80vh; /* increase height relative to viewport */
        }

            .custom-modal .modal-content {
                height: 100%; /* fill the modal dialog height */
            }
    </style>
</head>

<body style="background-color:#1E1E2F">
    <div class="modal fade" id="smallModal" tabindex="-1" aria-labelledby="smallModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <!-- modal-sm for small size -->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="smallModalLabel">Patient Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="status-text">All patient details are good.No high pressure detected</p>                    
                </div>
                <div class="modal-footer">                    
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <!-- NAVBAR -->
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">Patient Dashboard</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <!-- Alerts Dropdown -->
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Alerts <span class="badge bg-danger">0</span> <!-- dummy badge count -->
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">New patient report available</a></li>
                            <li><a class="dropdown-item" href="#">High blood pressure detected</a></li>
                            <li><a class="dropdown-item" href="#">Appointment reminder</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-center" href="#">View All Alerts</a></li>
                        </ul>
                    </li>

                    <!-- Logout Button -->
                    <li class="nav-item">
                        <a href="/Home/Index" class="btn btn-outline-danger btn-sm">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <!-- MAIN CONTENT -->
    <div class="container py-5 text-center">

        <div class="pricing-header mx-auto mb-5">
            <h1 style="color:white" class="fw-bold">Patient Data</h1>
        </div>
       

        <!-- ⭐ TABLE ADDED HERE ⭐ -->
        <div class="container mt-4">
            <table class="table table-bordered table-striped table-hover text-start">
                <thead class="table-dark">
                    <tr>
                        <th >Patient ID</th>
                        <th>Patient Name</th>
                        <th >Action</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>1c0fd777</td>
                        <td>Michael Turner</td>
                        <td>
                            <span class="badge text-bg-primary" style="cursor:pointer;"
                                    onclick="loadPatientData('1c0fd777','John Smith')">
                                View
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>71e66ab3</td>
                        <td>Emily Brooks</td>
                        <td>
                            <span class="badge text-bg-primary" style="cursor:pointer;"
                                  onclick="loadPatientData('71e66ab3','Emma Wilson')">
                                View
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>d13043b3</td>
                        <td>Jason Miller</td>
                        <td>
                            <span class="badge text-bg-primary" style="cursor:pointer;"
                                    onclick="loadPatientData('d13043b3','Ravi Kumar')">
                                View
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td>543d4676</td>
                        <td>Olivia Harris</td>
                        <td>
                            <span class="badge text-bg-primary" style="cursor:pointer;"
                                    onclick="loadPatientData('543d4676','Sophia Davis')">
                                View
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td>de0e9b2c</td>
                        <td>John Willson</td>
                        <td>
                            <span class="badge text-bg-primary" style="cursor:pointer;"
                                    onclick="loadPatientData('de0e9b2c','Sophia Davis')">
                                View
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- ⭐ END TABLE ⭐ -->

    </div>


    <div  class="modal fade" id="patientModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><b>Patient Report</b></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4" id="metricsContainer"></div>

                    <!-- New textbox and submit button row -->
                    <div class="row mt-3">
                        <div class="col-md-12"></div> <!-- empty space to push to right -->
                        <div class="col-md-8">
                            <form id="noteForm">
                                <div class="mb-2">
                                    <textarea class="form-control" id="noteText" placeholder="Enter patient remark"></textarea>
                                </div>
                                <button type="button" onclick="SaveNotes()" class="btn btn-primary w-50">Save</button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    @*Open Image on click*@
    <div  class="modal fade" id="heatMapModel" tabindex="-1">
        <div  class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- New textbox and submit button row -->
                    <div class="row mt-12">
                        <div class="col-md-12" id="metricsContainer_heatmap"></div> <!-- empty space to push to right -->
                        <div class="col-md-12">                       
                    </div>

                </div>
            </div>
        </div>
    </div>



    <footer class="py-3">
        <p>© 2025 Clinician Portal — All rights reserved.</p>
    </footer>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function loadImage(id,formatted)
        {
            let html = "";
              html += `
                                                                <div   class="col-md-12">
                                                                    <div class="card shadow-sm p-3 text-center shadow-lg p-3 mb-5 bg-white rounded">
                                                           
                                                                    <img src="/Patient-Data/Heatmap/${id}_${formatted}.png"
                                                             class="img-fluid rounded mb-2"
                                                             alt="tst" />
                                                        </div>
                                                    </div>
                                                `;


                    console.log(html);
        document.getElementById("metricsContainer_heatmap").innerHTML = html;
            var modal = new bootstrap.Modal(document.getElementById("heatMapModel"),
                {
                    keyboard: true,
                    backdrop: "static"
                });
            modal.show();
        }


        function loadPatientData(id, name) {
            fetch('/Dashboard/GetPatientData', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id.toString() })
            })
                .then(res => res.json())
                .then(data => {
                    console.log("Response from C#:", data);
                    let html = "";
                    data.forEach(x => {
                        let formatted = x.date.split('/').reverse().join('');
                        console.log(formatted)
                        html += `
                                                                <div style="background-color:#EBD5D3" class="col-md-4">
                                                        <div class="card shadow-sm p-3 text-center">
                                                            <h5><b>${x.date}</b></h5>
                                                                                      <span class="btn btn-warning">Peak: ${x.peak} </span> <br/>
                                                                                    <span class="btn btn-success">Contact Area: ${x.contactArea}</span> <br/>
                                                                                    <span class="btn btn-info">Avg Pressure: ${x.avgPressure}</span> <br/>                                                                                              
                                                                                                             <button onClick="loadImage('${id}','${formatted}')" type="button" class="btn btn-success d-flex align-items-center gap-2">              <!-- Bar Chart Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-fill" viewBox="0 0 16 16">
                <rect x="1" y="10" width="3" height="5" rx="1"/>
                <rect x="6" y="6" width="3" height="9" rx="1"/>
                <rect x="11" y="2" width="3" height="13" rx="1"/>
              </svg>
              View Heatmap
            </button></div> </div>`;
                    });

                    console.log(html);
                    document.getElementById("metricsContainer").innerHTML = html;                   
                    var modal = new bootstrap.Modal(document.getElementById("patientModal"),
                        {
                            keyboard: true,
                            backdrop: "static"
                        });
                    modal.show();

                });
        }

        function SaveNotes() {
            
            var notes = document.getElementById('noteText').value;           

            fetch('/Dashboard/SaveNote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: 0,notes:notes })
            })
                .then(res => res.json())
                .then(data => {
                    alert("Record saved successfully!")
                });
        }
    </script>

</body>
</html>
