@model ClinicianPortal.Models.LoginModel
@{
    ViewData["Title"] = "Login";
}

<!-- Google Font: Lato -->
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Lato', sans-serif;
        background-color: #f8f9fa;
        height: 100vh;
        margin: 0;
    }

    .login-container {
        height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        width: 400px;
        padding: 35px 35px 25px 35px;
    }

        .login-card h4 {
            font-weight: 700;
            margin-bottom: 25px;
        }

    .form-control {
        border-radius: 5px;
        padding: 10px;
    }

    .btn-primary {
        width: 48%;
        padding: 10px;
        font-weight: 600;
        border-radius: 5px;
    }

    .btn-outline-secondary {
        width: 48%;
        padding: 10px;
        font-weight: 600;
        border-radius: 5px;
    }

    .fancy-text {
        font-size: 48px;
        font-weight: bold;
        background: linear-gradient(90deg, #00f0ff, #ff00f0); /* neon cyan to pink */
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
        text-shadow: 0 0 10px rgba(255, 0, 255, 0.7), 0 0 20px rgba(0, 255, 255, 0.7);
    }
</style>

<div class="login-container">
    <div class="login-card">

        <h4 class="text-center fancy-text" style="font-size:30px;"><b>Sensor Mapping</b></h4>

        <form asp-action="Index" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="Enter your Username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- LOGIN + SIGNUP SIDE BY SIDE -->
            <div class="d-flex justify-content-between mt-3">
                <button type="submit" class="btn btn-primary">Login</button>

                <a asp-controller="Account" asp-action="Index" class="btn btn-outline-secondary">
                    Sign Up
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
